{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "candidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "cohort": {
          "type": "string",
          "enum": [
            "core",
            "control",
            "floor",
            "conditional",
            "ceiling"
          ]
        },
        "runnable": {
          "type": "boolean",
          "const": true
        },
        "source": {
          "type": "object",
          "properties": {
            "huggingFaceId": {
              "type": "string",
              "minLength": 3
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "license": {
              "type": "string",
              "enum": [
                "Apache-2.0",
                "MIT"
              ]
            },
            "licenseUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "huggingFaceId",
            "revision",
            "url",
            "license",
            "licenseUrl"
          ],
          "additionalProperties": false
        },
        "contextTokens": {
          "type": "number",
          "const": 65536
        },
        "runtime": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "enum": [
                "vllm",
                "llama.cpp",
                "sglang"
              ]
            },
            "toolParser": {
              "type": "string",
              "minLength": 1
            },
            "reasoning": {
              "type": "string",
              "const": "disabled"
            },
            "temperature": {
              "type": "number",
              "const": 0
            },
            "concurrency": {
              "type": "number",
              "const": 1
            },
            "chatTemplateArgs": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "engine",
            "toolParser",
            "reasoning",
            "temperature",
            "concurrency",
            "chatTemplateArgs"
          ],
          "additionalProperties": false
        },
        "quantization": {
          "type": "string",
          "minLength": 1
        },
        "weightEstimateGiB": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "kvCache64kEstimateGiB": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hardwareTier": {
          "type": "string",
          "enum": [
            "16",
            "24",
            "32-48"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "displayName",
        "cohort",
        "runnable",
        "source",
        "contextTokens",
        "runtime",
        "quantization",
        "weightEstimateGiB",
        "kvCache64kEstimateGiB",
        "hardwareTier",
        "notes"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "enum": [
        "protocol",
        "quality",
        "warm-performance",
        "cold-load",
        "capacity"
      ]
    },
    "corpus": {
      "type": "object",
      "properties": {
        "suite": {
          "type": "string",
          "enum": [
            "envited-x",
            "toyverse"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "caseCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "repetitions": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "warmups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "suite",
        "digest",
        "caseCount",
        "repetitions",
        "warmups"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "contextTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "concurrency": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxAgentSteps": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "lookupTools": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retrieval": {
          "type": "object",
          "properties": {
            "maxDomains": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxCards": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxContextChars": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "maxDomains",
            "maxCards",
            "maxContextChars"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contextTokens",
        "temperature",
        "concurrency",
        "maxAgentSteps",
        "lookupTools",
        "retrieval"
      ],
      "additionalProperties": false
    },
    "runDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "collection": {
          "type": "string",
          "enum": [
            "client-only",
            "server-pid",
            "launched"
          ]
        },
        "launch": {
          "type": "object",
          "properties": {
            "command": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "readinessUrl": {
              "type": "string"
            },
            "shutdownTimeoutMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "command",
            "readinessUrl",
            "shutdownTimeoutMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "baseUrl",
        "model",
        "collection"
      ],
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "container": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "wsl": {
          "type": "boolean"
        },
        "cpuModel": {
          "type": "string"
        },
        "logicalCores": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "ramBytes": {
          "type": "number",
          "minimum": 0
        },
        "swapBytes": {
          "type": "number",
          "minimum": 0
        },
        "cgroupMemoryLimitBytes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "vramTotalBytes": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "uuid",
              "model",
              "vramTotalBytes"
            ],
            "additionalProperties": false
          }
        },
        "coverage": {
          "type": "object",
          "properties": {
            "processTree": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "client-only",
                "permission-denied",
                "tool-missing",
                "platform-unsupported",
                "rocm-unsupported",
                "metal-unsupported"
              ]
            },
            "gpu": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "client-only",
                "permission-denied",
                "tool-missing",
                "platform-unsupported",
                "rocm-unsupported",
                "metal-unsupported"
              ]
            }
          },
          "required": [
            "processTree",
            "gpu"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "platform",
        "release",
        "architecture",
        "container",
        "wsl",
        "cpuModel",
        "logicalCores",
        "ramBytes",
        "swapBytes",
        "cgroupMemoryLimitBytes",
        "gpu",
        "coverage"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "candidate",
    "profile",
    "corpus",
    "policy",
    "runDigest",
    "endpoint",
    "hardware"
  ],
  "additionalProperties": false
}
