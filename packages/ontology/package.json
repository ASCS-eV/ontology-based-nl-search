{
  "name": "@ontology-search/ontology",
  "description": "Ontology source resolution and graph-driven, ontology-agnostic schema discovery (domains, class hierarchy, SHACL validation).",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./src/ontology-catalog.ts",
      "import": "./dist/ontology-catalog.js",
      "default": "./dist/ontology-catalog.js"
    },
    "./domain-registry": {
      "types": "./src/domain-registry.ts",
      "import": "./dist/domain-registry.js",
      "default": "./dist/domain-registry.js"
    },
    "./shacl-validator": {
      "types": "./src/shacl-validator.ts",
      "import": "./dist/shacl-validator.js",
      "default": "./dist/shacl-validator.js"
    },
    "./sources": {
      "types": "./src/sources.ts",
      "import": "./dist/sources.js",
      "default": "./dist/sources.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check-types": "tsc --noEmit",
    "check-types:tests": "tsc -p tsconfig.test.json",
    "clean": "rimraf dist",
    "derive:openscenario-authoring": "node scripts/derive-openscenario-authoring-shacl.mjs",
    "derive:openscenario-authoring:check": "node scripts/derive-openscenario-authoring-shacl.mjs --check"
  },
  "dependencies": {
    "@ontology-search/core": "workspace:*",
    "@rdfjs/dataset": "^2.0.2",
    "fast-xml-parser": "^5.2.5",
    "n3": "^2.0.3",
    "rdf-validate-shacl": "^0.6.5"
  },
  "devDependencies": {
    "@ontology-search/typescript-config": "workspace:*",
    "@rdfjs/types": "^2.0.1",
    "@types/n3": "^1.26.1",
    "@types/node": "^25.7.0",
    "@types/rdfjs__dataset": "^2.0.7",
    "@vitest/coverage-v8": "3.2.4",
    "rimraf": "^6.0.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
