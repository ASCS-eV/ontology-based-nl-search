# Dependencies
node_modules/
# pnpm's content-addressable store, when it lands inside the workspace
.pnpm-store/

# Build
dist/
.next/
out/
tsconfig.tsbuildinfo

# Native WASM build scratch (packages/authoring-wasm/native/build.mjs)
.build/
# Environment
.env.local
.env.*.local

# Ontology source cache — materialized by scripts/fetch-ontology.mjs from the
# distribution pinned in ontology-package.json (version + sha256). Not checked
# in: the pin is the source of truth, the cache is 11 MB of derived files.
.ontology/

# Generated ontology sources config (use ontology-sources.example.json as template)
ontology-sources.json

# IDE
.vscode/
.idea/

# Local working scratchpad — audits, refactor plans, etc.
# Tracks transitional state we do not want in repo history.
.playground/

# Generated model-evaluation runs — evidence, never committed
.eval-runs/
plans/

# Claude Code working directory (scheduled-task lockfile, etc.)
.claude/

# OS
.DS_Store
Thumbs.db

# Debug
npm-debug.log*

# Test output
coverage/
playwright-report/
test-results/

# Evaluation results (generated by scripts/test-1000-queries.mjs)
scripts/eval/*.json

# Turbo
.turbo/

# VitePress
apps/docs/.vitepress/cache/
apps/docs/.vitepress/dist/
